# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Auth / sesión ───────────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-un-secreto-seguro
OWNER_OPEN_ID=

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_ID=comprando-america

# ─── Cloudinary (subida de imágenes) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OpenAI (generación de imágenes en CMS) ──────────────────────────────────
OPENAI_API_KEY=

# ─── Pipeline de noticias ─────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=glm-5.1:cloud
GEMINI_API_KEY=
PEXELS_API_KEY=

# ─── API admin (agente externo) ───────────────────────────────────────────────
ADMIN_TOKEN=

# ─── Metricool (distribución social) ─────────────────────────────────────────
METRICOOL_API_KEY=
METRICOOL_USER_ID=
METRICOOL_BLOG_CA=
METRICOOL_BLOG_ET=
METRICOOL_BLOG_TUM=

# ─── Base de audiencias compartida (newsletter 3 sitios) ─────────────────────
# Base MySQL/TiDB compartida entre comprando-america, edmundo-trevino y
# garantias-extraordinarias. Tablas mk_subscribers y mk_events (se crean
# solas al arrancar). La misma URL va en los 3 sitios.
MARKETING_DATABASE_URL=mysql://user:password@host:4000/marketing
# Resend — doble opt-in y envíos del newsletter
RESEND_API_KEY=
# Remitente verificado en Resend, ej: "Comprando América <news@comprandoamerica.com>"
RESEND_FROM=
# URL pública del sitio, para armar los links de verificación y baja
SITE_BASE_URL=https://comprandoamerica.com
