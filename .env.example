# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Auth / sesión ───────────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-un-secreto-seguro
OWNER_OPEN_ID=

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_ID=comprando-america

# ─── CMS (CA-CMS) ─────────────────────────────────────────────────────────────
# Servidor → CMS: todos los leads salen por aquí (server/_core/cmsLead.ts).
CMS_API_URL=https://ca-cms.onrender.com
# Token del CMS (encabezado x-api-key). Solo servidor; el boletín no entra sin él.
CMS_API_KEY=
# Lecturas públicas desde el navegador (portafolio). Nunca lleva tokens.
VITE_CRM_API_URL=https://ca-cms.onrender.com

# ─── Cloudinary (subida de imágenes) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OpenAI (generación de imágenes en CMS) ──────────────────────────────────
OPENAI_API_KEY=

# ─── Pipeline de noticias ─────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=glm-5.1:cloud
GEMINI_API_KEY=
PEXELS_API_KEY=

# ─── API admin (agente externo) ───────────────────────────────────────────────
ADMIN_TOKEN=

# ─── Metricool (distribución social) ─────────────────────────────────────────
METRICOOL_API_KEY=
METRICOOL_USER_ID=
METRICOOL_BLOG_CA=
METRICOOL_BLOG_ET=
METRICOOL_BLOG_TUM=
